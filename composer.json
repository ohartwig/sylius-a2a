{
    "name": "koh/sylius-a2a",
    "description": "An A2A 1.0 agent for Sylius: a JSON-RPC endpoint with deterministic catalogue skills and the Agent Card at /.well-known/agent-card.json.",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "a2a",
        "agent-card",
        "json-rpc",
        "agent",
        "ai"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source/sylius-agent-ready",
    "support": {
        "issues": "https://github.com/ohartwig/sylius-a2a/issues",
        "source": "https://github.com/ohartwig/sylius-a2a",
        "security": "https://github.com/ohartwig/sylius-a2a/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.3",
        "doctrine/orm": "^2.18 || ^3.5",
        "koh/sylius-agent-contracts": "^1.1",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/rate-limiter": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.5",
        "phpunit/phpunit": "^11.5.57"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusA2a\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusA2a\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
